{
  "manifest_version": 3,
  "name": "Phishing Detector",
  "description": "Detecta phishing en correos de Gmail usando el modelo champion de MLflow.",
  "version": "1.0.0",

  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://mail.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Phishing Detector – abrir opciones",
    "default_popup": "options.html"
  }
}
